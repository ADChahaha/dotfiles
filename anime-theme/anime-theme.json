{
  "name": "Custom Lua Theme",
  "type": "dark",
  "colors": {
    "editor.background": "#090300",
    "editor.foreground": "#d6d6d6",


    "editorCursor.foreground": "#d6d6d6",
    "editorCursor.background": "#090300",
    "editorCursor.border": "#d6d6d6",
    "editor.selectionBackground": "#5a5758",
    "editor.selectionForeground": "#d6d6d6",

    "sideBar.background": "#090300",
    "sideBar.foreground": "#d6d6d6",

    "activityBar.background": "#090300",
    "activityBar.foreground": "#d6d6d6",

    "statusBar.background": "#090300",
    "statusBar.foreground": "#d6d6d6",

    "tab.activeBackground": "#090300",
    "tab.activeForeground": "#d6d6d6",
    "tab.inactiveBackground": "#090300",
    "tab.inactiveForeground": "#a5a2a2",
    "tab.hoverBackground": "#090300",
    "tab.hoverForeground": "#d6d6d6",
    "tab.border": "#5a5758",

    "panel.background": "#090300",
    "panel.foreground": "#d6d6d6",

    "editorGroup.background": "#090300",
    "editorGroupHeader.tabsBackground": "#090300",

    "scrollbarSlider.background": "#5a5758",
    "scrollbarSlider.hoverBackground": "#7a7778",
    "scrollbarSlider.activeBackground": "#9a9798",

    "titleBar.activeBackground": "#090300",
    "titleBar.activeForeground": "#d6d6d6",
    "titleBar.inactiveBackground": "#090300",
    "titleBar.inactiveForeground": "#a5a2a2",
    "titleBar.border": "#5a5758",

    "editorGroup.border": "#5a5758",
    "sideBar.border": "#5a5758",
    "statusBar.border": "#5a5758"
  },
 "tokenColors": 
[
  {
    "scope": [
      "comment",
      "punctuation.definition.comment",
      "string.comment"
    ],
    "settings": {
      "foreground": "#6272a4",
      "fontStyle": "italic"
    }
  },
  {
    "scope": [
      "constant",
      "entity.name.constant",
      "variable.other.constant",
      "variable.language"
    ],
    "settings": {
      "foreground": "#bd93f9"
    }
  },
  {
    "scope": [
      "entity",
      "entity.name",
      "entity.other.attribute-name",
      "entity.other.attribute-name.id",
      "entity.name.tag",
      "entity.name.section",
      "entity.name.selector"
    ],
    "settings": {
      "foreground": "#ff79c6"
    }
  },
  {
    "scope": [
      "variable",
      "variable.parameter",
      "variable.language",
      "variable.other.readwrite"
    ],
    "settings": {
      "foreground": "#f8f8f2"
    }
  },
  {
    "scope": [
      "keyword",
      "keyword.control",
      "keyword.operator",
      "keyword.other",
      "keyword.function",
      "keyword.module",
      "keyword.type",
      "keyword.import",
      "storage.type",
      "storage.modifier"
    ],
    "settings": {
      "foreground": "#ff79c6"
    }
  },
  {
    "scope": [
      "storage",
      "storage.type",
      "storage.modifier",
      "storage.type.class",
      "storage.type.function",
      "storage.type.variable"
    ],
    "settings": {
      "foreground": "#ff79c6"
    }
  },
  {
    "scope": [
      "string",
      "constant.other.symbol",
      "constant.other.key",
      "constant.character.escape"
    ],
    "settings": {
      "foreground": "#f1fa8c"
    }
  },
  {
    "scope": [
      "support",
      "support.type",
      "support.class",
      "support.function",
      "support.constant",
      "support.variable"
    ],
    "settings": {
      "foreground": "#50fa7b"
    }
  },
  {
    "scope": [
      "entity.name.function",
      "meta.function-call",
      "variable.function",
      "support.function"
    ],
    "settings": {
      "foreground": "#50fa7b"
    }
  },
  {
    "scope": [
      "entity.name.type",
      "entity.name.class",
      "entity.name.namespace",
      "entity.other.attribute-name.class",
      "entity.other.attribute-name.namespace"
    ],
    "settings": {
      "foreground": "#8be9fd"
    }
  },
  {
    "scope": ["invalid", "invalid.deprecated"],
    "settings": {
      "foreground": "#ffffff",
      "background": "#ff5555"
    }
  }
]

}
